rules_version = '2';

// Spec 019 (ADR-0010): the domain (clubs, schedules, announcements, matches, ratings, absences) is written only by the
// Cloud Functions, which use the Admin SDK and skip these rules. The apps read what their membership allows and write
// directly only their own profile picture, devices and chat messages. Keep in sync with FirestorePaths.kt.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isStringOrNull(value) {
      return value == null || (value is string && value.size() <= 2048);
    }

    // Public profile (no email). Any signed-in user can read it (chat participants, user search by prefix).
    // completeProfile creates it; the owner can only change the picture.
    match /users/{uid} {
      allow read: if signedIn();
      allow update: if isUser(uid)
        && onlyChanges(['pictureUrl', 'updatedAt'])
        && isStringOrNull(request.resource.data.pictureUrl)
        && request.resource.data.updatedAt == request.time;
      allow create, delete: if false;

      // FCM tokens of the user's devices (document id = token)
      match /devices/{token} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.keys().hasOnly(['platform', 'locale', 'timeZone', 'appVersion', 'updatedAt'])
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
      }

      // Per-club settings (mute): written by setClubMuted
      match /clubSettings/{clubId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // Username reservations: only the Functions read and write them
    match /usernames/{name} {
      allow read, write: if false;
    }

    // Invitation codes: only the Functions read them (joinClub), so they cannot be listed
    match /invitationCodes/{code} {
      allow read, write: if false;
    }

    // Membership ids are `{clubId}_{uid}` (unique across clubs and stable when a member comes back)
    function myMembership(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(clubId + '_' + request.auth.uid);
    }

    function isMember(clubId) {
      return signedIn() && exists(myMembership(clubId)) && get(myMembership(clubId)).data.status == 'ACTIVE';
    }

    // Clubs and everything inside (schedule, matches, announcements, ratings, absences): active members read,
    // the Functions write (spec 019 ADR-0010 §2)
    match /clubs/{clubId} {
      allow read: if isMember(clubId);
      allow write: if false;

      // Members also see their own membership after leaving or being banned (the app drops the club then)
      match /members/{memberId} {
        allow read: if isMember(clubId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow write: if false;
      }

      match /{collection}/{document=**} {
        allow read: if collection != 'members' && isMember(clubId);
        allow write: if false;
      }
    }

    // "My clubs": the collection group query `members where userId == me`
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Chats: participants read; createChat / addChatParticipants / leaveChat change them (spec 019 AC-019-15)
    match /chats/{chatId} {
      function chat() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow write: if false;

      // Messages are written by the app: only participants, as themselves, with the server time; only the author
      // deletes them and nobody edits them (backend ChatMessageService)
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chat().participantIds;
        allow create: if signedIn()
          && request.auth.uid in chat().participantIds
          && request.resource.data.keys().hasOnly(['senderId', 'content', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
        allow update: if false;
      }
    }

    // Everything else (debugPushes of the emulator…) is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
